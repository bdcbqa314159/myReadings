#!/usr/bin/env bash
# My reading log. The database lives in THIS repo and stays local; the
# generated catalog collects in reports/ and the published site in docs/.
#
#   ./bw                    open the TUI
#   ./bw gui                open the desktop GUI
#   ./bw publish [msg]      regenerate catalog + site, commit, push
#   ./bw <verb> ...         add / again / edit / find / list / worked / year / remove / report
set -euo pipefail

repo="$(cd "$(dirname "$0")" && pwd)"
export BOOKWARD_DB="$repo/reading.db"

if [ $# -eq 0 ]; then
  exec "$repo/bin/bookward-tui"
fi

case "$1" in
  gui)
    exec "$repo/bin/bookward-gui"
    ;;
  publish)
    # The db is gitignored, so an edit is invisible to git until the catalog is
    # regenerated. This is the one command that closes that gap.
    #
    # main is protected (PR-only, signed, linear), so this opens a PR rather
    # than pushing. Merging stays a deliberate, separate act.
    (cd "$repo/reports" && "$repo/bin/bookward" report)
    python3 "$repo/scripts/build_page.py"
    cd "$repo"
    git add reports/reading-catalog.md reports/reading-catalog.pdf docs
    if git diff --cached --quiet; then
      echo "nothing to publish — the catalog already matches the log"
      exit 0
    fi
    msg="${2:-catalog: refresh}"
    branch="catalog/$(date +%Y%m%d-%H%M%S)"
    git switch -q -c "$branch"
    git commit -q -m "$msg"
    git push -q -u origin "$branch"
    gh pr create --title "$msg" \
      --body "Regenerated \`reports/reading-catalog.{md,pdf}\` and \`docs/index.html\` from the local log." \
      --head "$branch" --base main
    git switch -q main
    echo
    echo "to publish, merge it:"
    echo "  gh pr merge --squash --delete-branch $branch && git pull --ff-only"
    exit 0
    ;;
esac

cd "$repo/reports" # report output (tex/pdf + latexmk aux) lands here, not the repo root
exec "$repo/bin/bookward" "$@"
